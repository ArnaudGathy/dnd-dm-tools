{
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm run *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm build)",
      "Bash(pnpm dev)",
      "Bash(pnpm start)",
      "Bash(npx prisma *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(pnpm db:backup)",
      "Bash(pnpm db:deploy)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:migrate *)"
    ],
    "deny": [
      "Bash(*prisma migrate reset*)",
      "Bash(*prisma db push*)",
      "Bash(*prisma migrate diff*)",
      "Bash(*--shadow-database-url*)",
      "Bash(*--accept-data-loss*)",
      "Bash(*--force-reset*)",
      "Bash(pnpm db:restore*)"
    ]
  },
  "plansDirectory": ".claude/plans"
}
